{
    "name": "advent-of-brute-force-2026",
    "type": "module",
    "scripts": {
        "check": "tsc -p ./tsconfig.json",
        "format": "prettier --write ./",
        "new": "sh -c 'cp -r ./src/00 ./src/$1' --",
        "prepare": "husky",
        "solve": "bun test --timeout 0",
        "start": "bun solve --watch"
    },
    "devDependencies": {
        "@tsconfig/strictest": "^2.0.9",
        "@types/bun": "^1.4.4",
        "husky": "^9.1.7",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2"
    }
}
